{
	"name": "eye-academy-viva",
	"description": "Voice ophthalmology practice viva: TanStack Start, Firebase, OpenAI",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@8.15.0",
	"imports": {
		"#/*": "./src/*"
	},
	"scripts": {
		"dev": "vite dev --port 3000",
		"dev:local": "VITE_FIREBASE_API_KEY= VITE_FIREBASE_PROJECT_ID= FIREBASE_PROJECT_ID= GOOGLE_APPLICATION_CREDENTIALS= vite dev --port 3000",
		"generate-routes": "vite build",
		"build": "vite build",
		"preview": "vite preview",
		"format": "biome format",
		"lint": "biome lint",
		"check": "biome check",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"test:watch": "vitest",
		"checks": "tsx scripts/checks.ts",
		"smoke": "tsx scripts/smoke-built.ts",
		"preprocess:reference": "tsx scripts/preprocess-reference.ts",
		"emulators": "firebase emulators:start --only auth,firestore --project demo-eye-academy",
		"test:rules": "firebase emulators:exec --only firestore --project demo-eye-academy \"vitest run --config vitest.rules.config.ts\"",
		"test:e2e": "playwright test",
		"test:e2e:ci": "firebase emulators:exec --only auth,firestore --project demo-eye-academy \"playwright test\""
	},
	"dependencies": {
		"@tailwindcss/vite": "^4.1.18",
		"@tanstack/react-devtools": "0.10.15",
		"@tanstack/react-router": "1.170.46",
		"@tanstack/react-router-devtools": "1.167.4",
		"@tanstack/react-start": "1.169.7",
		"firebase": "^13.4.0",
		"firebase-admin": "^14.5.1",
		"minisearch": "^7.2.0",
		"nitro": "3.0.261103-rc",
		"openai": "^7.62.0",
		"react": "^19.2.0",
		"react-dom": "^19.2.0",
		"tailwindcss": "^4.1.18",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.5",
		"@firebase/rules-unit-testing": "^6.0.0",
		"@playwright/test": "1.57.0",
		"@tanstack/devtools-vite": "0.8.7",
		"@types/node": "^22.10.2",
		"@types/react": "^19.2.0",
		"@types/react-dom": "^19.2.0",
		"@vitejs/plugin-react": "^6.0.1",
		"firebase-tools": "^15.37.0",
		"seroval": "1.8.2",
		"tsx": "^4.23.15",
		"typescript": "^6.0.2",
		"unpdf": "^2.2.2",
		"vite": "^8.0.0",
		"vitest": "^5.1.1"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"esbuild",
			"lightningcss"
		]
	},
	"engines": {
		"node": ">=22"
	}
}
