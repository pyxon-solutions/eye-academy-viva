# OpenAI (speech-to-text, examiner reasoning, examiner voice)
OPENAI_API_KEY=

# --- Firebase -------------------------------------------------------------
# Leave everything below empty to run against the local emulators
# (`pnpm emulators`, project "demo-eye-academy").

# Browser SDK (Firebase console → Project settings → Your apps → Web app)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Server (Admin SDK): same project id, plus a service-account key file.
# Never commit the key file; `service-account*.json` is git-ignored.
FIREBASE_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
